DISCORD_TOKEN=
# Which model judges posts: anthropic (Claude Haiku 5.5, the default) or deepseek
NSA_PROVIDER=anthropic
# Needed for NSA_PROVIDER=anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
# Needed for NSA_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# Required. Comma-separated Discord user IDs allowed to run anything that spends API credits
# (scan, scanall, watch, unwatch, dossier, usage).
NSA_ADMIN_IDS=
# Required. Comma-separated server IDs. The bot leaves any other server it gets added to.
NSA_GUILD_IDS=

# Optional. Keep comments on their own lines: Docker Compose treats "KEY=  # note" as a value.

# Live mode: judge once this many posts are queued
NSA_QUEUE_TRIGGER=40
# Live mode: also flush whatever is queued this often
NSA_HEARTBEAT_MINUTES=10
# Only posts at/above this severity go to the report channel
NSA_REPORT_MIN_SEVERITY=5
# Shorter messages ("w", "lol") are kept as context but not scored
NSA_MIN_CHARS=3
# Earlier messages from the same channel shown to the judge before each batch
NSA_CONTEXT_MESSAGES=15
# Live mode: max posts queued per user per minute (anti-spam)
NSA_USER_RATE=10
# Comma-separated channel IDs the bot never reads
NSA_IGNORE_CHANNEL_IDS=
# Model calls in flight at once. Blank = 8 on Claude (its per-minute limits are tighter, and new
# accounts start lower), 16 on DeepSeek (allows up to 2,500). More = faster, same total cost.
NSA_CONCURRENCY=
# Let everyone use /dossier (admins always can): on/off
NSA_DOSSIER_PUBLIC=on
# Dossiers per person per hour when public
NSA_DOSSIER_PER_USER_HOUR=3
# Let everyone use /roast (admins always can): on/off
NSA_ROAST_PUBLIC=off
# Roasts per person per hour when public
NSA_ROAST_PER_USER_HOUR=3
# Reply to a message and @ the bot to get its take: on (everyone), admins, off
NSA_RESPOND=on
# Responses per person per hour, 0 = unlimited (admins always unlimited)
NSA_RESPOND_PER_USER_HOUR=0
# Think before replying: on/off
NSA_RESPOND_THINKING=on
# Agent read API: comma-separated name:sha256 entries from `python3 -m nsabot.apikey <name>`.
# Leave empty to keep the API off.
NSA_API_KEYS=
# Requests per minute per key
NSA_API_RATE_PER_MINUTE=60
# Let the judge look at pictures (image attachments and link previews; no GIFs or stickers): on/off
NSA_IMAGES=on
# Most pictures sent with one batch of posts (each costs up to ~1k tokens)
NSA_IMAGES_PER_BATCH=10
# VAR: replay posts people delete themselves and air them if they were kimoi: on/off
NSA_VAR=on
# Minimum score for VAR to air a deleted post (blank = same as NSA_REPORT_MIN_SEVERITY)
NSA_VAR_MIN_SEVERITY=
# DeepSeek reviews per person per hour (stops post-and-delete spam)
NSA_VAR_PER_USER_HOUR=5
# Let the analyst crack a joke when DeepSeek thinks the moment calls for it: on/off
NSA_QUIPS=on
# At most one quip per server this often
NSA_QUIP_COOLDOWN_MINUTES=30
# Max history messages per channel per !scan
NSA_SCAN_LIMIT=5000
# --- Claude (NSA_PROVIDER=anthropic) ---
ANTHROPIC_MODEL=claude-haiku-5-5
# Think before answering: on/off. Off means effort "low" (Claude still thinks a little when it needs to).
NSA_THINKING=on
# Thinking effort: low, medium, high, xhigh or max. Blank = the model's default (medium on Haiku 5.5).
NSA_EFFORT=
# Output tokens allowed for thinking per call; batches that run out are split in half and retried
NSA_THINKING_TOKENS=32000
# Optional: judge batches through a Managed Agent built in the Claude Console (Agents) instead of
# direct calls. Set both IDs. The bot keeps the agent's system prompt in sync with its judge prompt.
NSA_AGENT_ID=
NSA_ENVIRONMENT_ID=
# Hard spend cap per batch session, in USD (list prices)
NSA_AGENT_BUDGET_USD=0.25
# Keep each batch's session in the Console for inspection (off = delete it once judged; failed ones are kept)
NSA_AGENT_KEEP_SESSIONS=off

# --- DeepSeek (NSA_PROVIDER=deepseek) ---
# deepseek-flash (V4.1-Flash) or deepseek-v4-pro. deepseek-chat is a deprecated alias.
DEEPSEEK_MODEL=deepseek-flash
# Think before answering: on/off. On is more accurate on irony/context, slower and uses more tokens.
DEEPSEEK_THINKING=on
# Thinking effort: low, high or max. Blank = DeepSeek's default (high). Low is cheaper and faster.
DEEPSEEK_REASONING_EFFORT=
# Output tokens allowed for thinking per call; batches that run out are split in half and retried
DEEPSEEK_THINKING_TOKENS=32000
DEEPSEEK_BASE_URL=https://api.deepseek.com
NSA_DB_PATH=nsa.db
NSA_PREFIX=!
