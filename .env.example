DISCORD_TOKEN=
DEEPSEEK_API_KEY=

# Required. Comma-separated Discord user IDs allowed to run anything that spends API credits
# (scan, scanall, watch, unwatch, dossier, budget).
NSA_ADMIN_IDS=
# Required. Comma-separated server IDs. The bot leaves any other server it gets added to.
NSA_GUILD_IDS=

# Optional
NSA_DAILY_TOKEN_BUDGET=1000000   # hard daily DeepSeek token cap (UTC day); queue pauses when hit
NSA_QUEUE_TRIGGER=40             # live mode: judge once this many posts are queued
NSA_HEARTBEAT_MINUTES=10         # live mode: also flush whatever is queued this often
NSA_REPORT_MIN_SEVERITY=5        # only posts at/above this severity go to the report channel
NSA_MIN_CHARS=3                  # skip shorter messages (saves tokens)
NSA_IGNORE_CHANNEL_IDS=          # channels never read
NSA_SCAN_LIMIT=5000              # max history messages per channel per !scan
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
NSA_DB_PATH=nsa.db
NSA_PREFIX=!
